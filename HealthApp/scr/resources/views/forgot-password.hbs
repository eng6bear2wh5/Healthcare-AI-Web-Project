

<div class="mt-4">
    <form method="POST" action="/auth/verify-otp-forgotpassword">
        <div class="mb-3">
            <label for="email-input">Email</label>
            <input type="email" name="email" class="form-control" id="email-input" placeholder="Nhập email">
        </div>

        <div class="mt-2">
            <button type="button" class="btn btn-link p-0" onclick="sendOTP()">Gửi OTP</button>
        </div>

        <div class="mb-3 mt-2">
            <label for="otp-input">Mã OTP</label>
            <input type="text" name="otp" class="form-control" id="otp-input" placeholder="Nhập mã OTP">
        </div>

        <button type="submit" class="btn btn-primary">Xác thực</button>

        <!-- Thông báo gửi OTP -->
        <p id="otp-message" class="text-success mt-2" style="display: none;">OTP đã được gửi!</p>
    </form>
</div>

<script>
    async function sendOTP() {
        const email = document.getElementById("email-input").value;
        const message = document.getElementById("otp-message");

        if (!email) {
            alert("Vui lòng nhập email!");
            return;
        }

        try {
            const response = await fetch("/auth/send-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: email })
            });

            if (response.ok) {
                message.style.display = "block"; // Hiển thị thông báo thành công
                message.textContent = "OTP đã được gửi!";
                message.classList.add("text-success");
            } else {
                message.style.display = "block";
                message.textContent = "Gửi OTP thất bại!";
                message.classList.add("text-danger");
            }
        } catch (error) {
            console.error("Lỗi khi gửi OTP:", error);
            message.style.display = "block";
            message.textContent = "Lỗi server!";
            message.classList.add("text-danger");
        }
    }
</script>
