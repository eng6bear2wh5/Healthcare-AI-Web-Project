<div class="mt-4">
    <form method="POST" action="/auth/register">
        <div class="mb-3">
            <label for="search-input">Username</label>
            <input type="text" name="username" class="form-control" id="search-input" placeholder="Nhập username">
        </div>
        
        <div class="mb-3">
            <label for="search-input">Email</label>
            <input type="email" name="email" class="form-control" id="search-input" placeholder="Nhập email">
        </div>

        <div class="mb-3">
            <label for="search-input">Password</label>
            <input type="text" name="password" class="form-control" id="search-input" placeholder="Nhập password">
        </div>

        
  
        <button type="submit" class="btn btn-primary">Đăng ký</button>
    </form>
</div>  