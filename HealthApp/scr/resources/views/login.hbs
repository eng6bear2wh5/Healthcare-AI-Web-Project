<div class="mt-4">
    <form method="POST" action="/auth/login">
        <div class="mb-3">
            <label for="email-input">Email</label>
            <input type="email" name="email" class="form-control" id="email-input" placeholder="Nhập email">
        </div>

        <div class="mb-3">
            <label for="password-input">Password</label>
            <input type="password" name="password" class="form-control" id="password-input" placeholder="Nhập password">
        </div>

        <div class="mt-2">
            <a href="/forgot-password">Quên mật khẩu?</a>
        </div>

        <button type="submit" class="btn btn-primary">Đăng nhập</button>
    </form>
</div>
