<div class="mt-4">
    <form method="POST" action="/auth/reset-password">
        <div class="mb-3">
            <label for="search-input">Email</label>
            <input type="email" name="email" value="{{email}}" class="form-control" id="search-input" placeholder="Nhập email">
        </div>

        <div class="mb-3">
            <label for="search-input">Password</label>
            <input type="text" name="password" class="form-control" id="search-input" placeholder="Nhập password mới">
        </div>

        <button type="submit" class="btn btn-primary">Đổi mật khẩu mới</button>
    </form>
</div>  