<div class="mt-4">
    <form method="POST" action="/auth/verify-otp-login">
        <div class="mb-3">
            <label for="search-input">Email</label>
            <input type="email" name="email" value="{{email}}" class="form-control" id="search-input" placeholder="Nhập email">
        </div>

        <div class="mb-3">
            <label for="search-input">Mã OTP</label>
            <input type="text" name="otp" class="form-control" id="search-input" placeholder="Nhập mã OTP">
        </div>

        
  
        <button type="submit" class="btn btn-primary">Xác thực</button>
    </form>
</div>  